+DECK,USER02. **********************************************************
      SUBROUTINE USER02
      IMPLICIT NONE
+CDE, PHCDE.
+CDE, PSCVEC.
+CDE, PSCVECJJ.
+CDE, PSCEVT.
+CDE, PSCELD.
+CDE, PSCMUD.
+CDE, PSCMUL.
+CDE, PSCMUT.
      INTEGER I,J,MASK,IERR
      CALL PSBEG
      MASK=0
      CALL SBIT1(MASK,1)
      CALL SBIT1(MASK,32)
      WRITE(*,100) IIIRUN,IIIEVT,NVECP,ECMAS
      CALL FIXCONV
      CALL PSJETS(6,0.01,MASK,IERR)
      WRITE(*,102) ECHAR,EMNEU,EHNEU
      WRITE(*,103) NJET,IERR
      DO I=1,NVECP
         WRITE(*,101) I,VECP(1,I),VECP(2,I),VECP(3,I),
     +        VECP(4,I),VECP(5,I),VECP(7,I),KELID(1,I),
     +        KELID(2,I),KMUID(1,I),KMULS(1,I),
     +        KMUTI(1,I),LVLOCK(I)
         WRITE(*,105) I,IVECP(10,I)
      ENDDO
      IF (IAND(IERR,1).EQ.0) THEN
         DO J=1,NJET
            WRITE(*,104) J,VECP(1,LVJET+J),VECP(2,LVJET+J),
     +           VECP(3,LVJET+J),VECP(4,LVJET+J),
     +           VECP(5,LVJET+J)
         ENDDO
      ENDIF
 100  FORMAT('PROBE EVENT ',I10,1X,I10,1X,I5,1X,F12.6)
 101  FORMAT('PROBE OBJ ',I5,1X,6(ES16.8,1X),5(I10,1X),Z8.8)
 102  FORMAT('PROBE ENERGY ',3(ES16.8,1X))
 103  FORMAT('PROBE JETS ',I5,1X,I5)
 104  FORMAT('PROBE JET ',I5,1X,5(ES16.8,1X))
 105  FORMAT('PROBE LINK ',I5,1X,I5)
      END
*
